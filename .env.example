# Copia este archivo a ".env" y rellena tus propios valores.

# Obligatorio: tu API key de Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Opcionales: personalizan el nombre y el tema del asistente.
# Si los dejas vacios se usan valores genericos por defecto.
BOT_NAME=Asistente RAG
BOT_TOPIC=la informacion de los documentos proporcionados

# Opcional: imprime por consola la reescritura de la pregunta que se usa
# para buscar en los documentos. Util para depurar la recuperacion.
DEBUG_REESCRITURA=false

# Opcional: el bot cita sus fuentes con marcadores [1], [2]... y al final
# de cada respuesta se imprime de que documento y pagina sale cada una.
# Actívalo cuando la trazabilidad importe mas que la naturalidad.
MOSTRAR_FUENTES=false

# Opcional: solo si activas USAR_RERANKER con RERANKER_BACKEND="cohere" en
# rag.py. Requiere ademas "pip install cohere". El backend por defecto
# ("llm") no necesita ninguna key adicional.
COHERE_API_KEY=

# --- Solo para la API (api.py) ----------------------------------------
# Antes de exponer la API a internet, repasa la checklist del README.

# Clave de ADMINISTRACION: protege subir documentos y reindexar. Los
# usuarios finales no la necesitan (usan la cookie de sesion). Si la dejas
# vacia, esos endpoints quedan ABIERTOS.
API_KEY=

# OBLIGATORIA en produccion: firma las cookies de sesion. Generala con
#   python -c "import secrets; print(secrets.token_hex(32))"
# Si la dejas vacia se usa una efimera y las sesiones caducan en cada
# reinicio (y con varios workers cada uno firmaria distinto).
SECRET_KEY=

# Origenes permitidos para CORS, separados por comas. Vacio = ninguno.
# El comodin "*" se ignora a proposito: con cookies nunca es correcto.
# Ej: https://miapp.com,https://www.miapp.com
ORIGENES_CORS=

# Cookies solo por HTTPS. Ponlo a false SOLO para probar en local sin TLS.
COOKIES_SEGURAS=true

# Ponlo a true solo si hay un proxy inverso delante que fija
# X-Forwarded-For. Si no, cualquiera podria falsearla y saltarse el
# limite por IP.
CONFIAR_EN_PROXY=false

# Limites de abuso.
MAX_CHARS_PREGUNTA=2000
MAX_MENSAJES_POR_SESION=100
SEGUNDOS_EXPIRACION_SESION=86400
LIMITE_PETICIONES_MINUTO=10
LIMITE_PETICIONES_DIA=200
MAX_BYTES_SUBIDA=26214400

# Timeouts, para que una peticion colgada no retenga un worker.
TIMEOUT_MODELO_SEGUNDOS=60
TIMEOUT_INDEXADO_SEGUNDOS=300

# Observabilidad. LOG_PREGUNTAS registra el texto de las preguntas: son
# datos del usuario, dejalo en false salvo para depurar.
LOG_NIVEL=INFO
LOG_PREGUNTAS=false

# Opcional: donde guardar la base de sesiones e historiales.
# Por defecto data/historial.db
RUTA_BD_HISTORIAL=
