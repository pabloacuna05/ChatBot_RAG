# Copia este archivo a ".env" y rellena tus propios valores.

# Obligatorio: tu API key de Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Opcionales: personalizan el nombre y el tema del asistente.
# Si los dejas vacios se usan valores genericos por defecto.
BOT_NAME=Asistente RAG
BOT_TOPIC=la informacion de los documentos proporcionados

# Opcional: imprime por consola la reescritura de la pregunta que se usa
# para buscar en los documentos. Util para depurar la recuperacion.
DEBUG_REESCRITURA=false

# Opcional: el bot cita sus fuentes con marcadores [1], [2]... y al final
# de cada respuesta se imprime de que documento y pagina sale cada una.
# Actívalo cuando la trazabilidad importe mas que la naturalidad.
MOSTRAR_FUENTES=false

# Opcional: solo si activas USAR_RERANKER con RERANKER_BACKEND="cohere" en
# rag.py. Requiere ademas "pip install cohere". El backend por defecto
# ("llm") no necesita ninguna key adicional.
COHERE_API_KEY=

# --- Solo para la API (api.py) ----------------------------------------
# Clave que los clientes deben enviar en la cabecera X-API-Key. Si la dejas
# vacia la API queda ABIERTA: vale para probar en local, nunca para
# exponerla en red.
API_KEY=

# Opcional: donde guardar la base de historiales por sesion.
# Por defecto data/historial.db
RUTA_BD_HISTORIAL=
